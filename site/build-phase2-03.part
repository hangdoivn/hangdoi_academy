write('hoc-vien',head('Hành trình học viên nhiếp ảnh | Hang Đôi Academy','Hành trình từ người mới đến sản phẩm đầu ra và định hướng nhiếp ảnh phù hợp tại Hang Đôi Academy.',ROOT+'/hoc-vien/')+f'''<body class="p2-page">{nav()}<main><section class="p2-hero"><div class="p2-wrap"><span class="p2-eyebrow">Hành trình học viên</span><h1>Tiến bộ được nhìn bằng sản phẩm.</h1><p class="p2-lead">Mỗi case cần cho thấy điểm bắt đầu, nhịp thực hành, vấn đề đã vượt qua và hướng phát triển tiếp theo.</p></div></section><section class="p2-section alt"><div class="p2-wrap"><div class="p2-section-head"><h2>Công Tùng: từ ngại giao tiếp đến tìm ra hướng chụp sản phẩm.</h2><p>Xuất phát từ Đông Giang và duy trì ba buổi học mỗi tuần.</p></div><div class="p2-grid"><article class="p2-card"><b>01 · Bắt đầu</b><h3>Thích máy ảnh và ánh sáng.</h3><p>Chưa có quy trình rõ và còn ngại tương tác trong buổi chụp.</p></article><article class="p2-card yellow"><b>02 · Duy trì</b><h3>Đều đặn ba buổi mỗi tuần.</h3><p>Thực hành, nhận feedback và sửa lỗi theo từng bài tập.</p></article><article class="p2-card dark"><b>03 · Định hướng</b><h3>Dần nhận ra mình thích chụp sản phẩm.</h3><p>Tiếp tục thử thêm các hướng mới để hoàn thiện portfolio.</p></article></div></div></section></main>{footer()}</body></html>''')

articles=[('chon-may-anh-cho-nguoi-moi','Cách chọn máy ảnh cho người mới học nhiếp ảnh','Ưu tiên hệ thống dễ học, ngân sách cho ống kính và khả năng sử dụng lâu dài thay vì chỉ nhìn thông số thân máy.'),('lightroom-hay-photoshop','Người mới nên học Lightroom hay Photoshop trước?','Lightroom phù hợp để quản lý và chỉnh một bộ ảnh; Photoshop phù hợp với retouch và xử lý chi tiết sâu.'),('hoc-nhiep-anh-mat-bao-lau','Học nhiếp ảnh mất bao lâu để tự chụp được?','Thời gian phụ thuộc mục tiêu, nhịp thực hành và mức độ feedback. Một lộ trình cơ bản nên đủ để làm chủ máy và hoàn thiện bộ ảnh đầu tiên.')]
article_cards=''.join(f'<article class="p2-card"><b>Kiến thức nền</b><h3>{title}</h3><p>{desc}</p><a class="p2-cta" href="/blog/{slug}/">Đọc bài</a></article>' for slug,title,desc in articles)
write('blog',head('Kiến thức nhiếp ảnh cho người mới | Hang Đôi Academy','Hướng dẫn nhiếp ảnh, thiết bị, ánh sáng và hậu kỳ dành cho người mới từ Hang Đôi Academy.',ROOT+'/blog/')+f'<body class="p2-page">{nav()}<main><section class="p2-hero"><div class="p2-wrap"><span class="p2-eyebrow">Knowledge base</span><h1>Kiến thức để bắt đầu đúng.</h1><p class="p2-lead">Các hướng dẫn nền tảng về máy ảnh, ánh sáng, hậu kỳ và lộ trình học.</p></div></section><section class="p2-section alt"><div class="p2-wrap"><div class="p2-grid">{article_cards}</div></div></section></main>{footer()}</body></html>')
for slug,title,desc in articles:
 schema={'@context':'https://schema.org','@type':'Article','headline':title,'description':desc,'mainEntityOfPage':ROOT+'/blog/'+slug+'/','publisher':{'@type':'EducationalOrganization','name':'Hang Đôi Academy'}}
 body=f'''<body class="p2-page">{nav()}<main><section class="p2-hero"><div class="p2-wrap p2-article"><div class="p2-breadcrumb"><a href="/">Trang chủ</a> / <a href="/blog/">Kiến thức</a></div><span class="p2-eyebrow">Hướng dẫn nhiếp ảnh</span><h1>{title}</h1><p class="p2-lead">{desc}</p></div></section><section class="p2-section alt"><div class="p2-wrap p2-article"><h2>Bắt đầu từ mục tiêu sử dụng</h2><p>Thiết bị và phần mềm chỉ là công cụ. Quyết định nên dựa trên loại hình ảnh bạn muốn tạo, tần suất thực hành và khả năng đầu tư trong dài hạn.</p><h2>Ưu tiên khả năng thực hành</h2><p>Một lựa chọn phù hợp là lựa chọn giúp bạn chụp thường xuyên, xem lại lỗi và cải thiện qua từng bài tập.</p><h2>Khi nào nên học có hướng dẫn?</h2><p>Khi bạn đã thử tự học nhưng vẫn lặp lại cùng một lỗi, feedback trực tiếp sẽ giúp rút ngắn thời gian và xây quy trình rõ ràng hơn.</p><p><a class="p2-cta" href="/#tu-van">Nhận tư vấn lộ trình</a></p></div></section></main>{footer()}</body>'''
 write('blog/'+slug,head(title+' | Hang Đôi Academy',desc,ROOT+'/blog/'+slug+'/',schema)+body+'</html>')

urls=['/','/khoa-hoc/']+[f'/{c[0]}/' for c in courses]+['/giang-vien/','/hoc-vien/','/blog/']+[f'/blog/{s}/' for s,_,_ in articles]
sitemap='<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n'+''.join(f'<url><loc>{ROOT}{u}</loc><changefreq>weekly</changefreq><priority>{"1.0" if u=="/" else "0.8"}</priority></url>\n' for u in urls)+'</urlset>'
(OUT/'sitemap.xml').write_text(sitemap,encoding='utf-8')
