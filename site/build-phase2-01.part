from pathlib import Path
import json
ROOT='https://academy.hangdoiproduction.com'; OUT=Path('_site')
courses=[
('nhiep-anh-co-ban','Nhiếp ảnh cơ bản','Nền tảng','6.680.000đ','12 buổi','Dành cho người mới muốn làm chủ máy ảnh, hiểu ánh sáng và tự hoàn thiện bộ ảnh đầu tiên.','Người mới bắt đầu hoặc đang chụp theo cảm tính.','Tự thiết lập máy, chụp và hoàn thiện bộ ảnh đầu tiên.',['Làm chủ máy ảnh','Tư duy hình ảnh','Thực hành với người thật','Chọn ảnh và hậu kỳ cơ bản']),
('ky-thuat-nhiep-anh','Kỹ thuật nhiếp ảnh','Chuyên sâu','18.680.000đ','Theo lộ trình cá nhân','Đi sâu vào góc máy, bố cục, pose, giao tiếp và quy trình xử lý một buổi chụp.','Người đã biết vận hành máy và muốn nâng chất lượng hình ảnh.','Tự triển khai concept và xử lý buổi chụp theo quy trình.',['Đọc brief và moodboard','Góc máy và ngôn ngữ hình ảnh','Pose và giao tiếp','Project cá nhân']),
('ky-thuat-anh-sang','Kỹ thuật ánh sáng','Chuyên sâu','18.680.000đ','Theo lộ trình cá nhân','Hiểu nguồn sáng, modifier và cách kiểm soát tương phản trong studio lẫn bối cảnh thật.','Người muốn chủ động tạo và kiểm soát ánh sáng.','Tự setup ánh sáng cho chân dung, sản phẩm và concept.',['Đọc chất lượng ánh sáng','Modifier và khoảng cách','Setup studio','Ánh sáng on-location']),
('chinh-sua-hinh-anh','Chỉnh sửa hình ảnh','Chuyên sâu','18.680.000đ','Theo lộ trình cá nhân','Xây workflow hậu kỳ từ đánh giá ảnh, retouch đến color grading và xuất file.','Người đã chụp được ảnh nhưng hậu kỳ chưa ổn định.','Hoàn thiện ảnh đúng sáng, đúng màu và nhất quán theo bộ.',['Đánh giá và phân loại ảnh','Retouch không phá hủy','Color grading','Quản lý file và xuất bản']),
('nhiep-anh-toan-tap','Nhiếp ảnh toàn tập','Lộ trình làm nghề','40.000.000đ','Có thể chia tối đa 3 đợt','Lộ trình toàn diện từ kỹ thuật, ánh sáng và hậu kỳ đến portfolio và định hướng công việc.','Người xác định học nghiêm túc để xây năng lực làm nghề.','Portfolio cá nhân và nền tảng để bắt đầu nhận việc phù hợp.',['Tư duy và kỹ thuật','Ánh sáng và sản xuất','Hậu kỳ hoàn chỉnh','Portfolio và định hướng nghề'])]

def head(title,desc,url,schema=None):
 s=schema or {'@context':'https://schema.org','@type':'WebPage','name':title,'description':desc,'url':url,'inLanguage':'vi-VN'}
 return f'<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><meta name="description" content="{desc}"><link rel="canonical" href="{url}"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="{title}"><meta property="og:description" content="{desc}"><meta property="og:url" content="{url}"><link rel="stylesheet" href="/phase2.css"><script type="application/ld+json">{json.dumps(s,ensure_ascii=False,separators=(",",":"))}</script></head>'

def nav(): return '<nav class="p2-nav"><div class="p2-wrap p2-nav-inner"><a class="p2-brand" href="/">HANG ĐÔI <span>ACADEMY</span></a><div class="p2-nav-links"><a href="/khoa-hoc/">Khóa học</a><a href="/giang-vien/">Giảng viên</a><a href="/hoc-vien/">Học viên</a><a href="/blog/">Kiến thức</a></div><a class="p2-cta" href="/#tu-van">Nhận tư vấn</a></div></nav>'
def footer(): return '<footer class="p2-footer"><div class="p2-wrap p2-footer-grid"><div><strong>Hang Đôi Academy</strong><p>Đào tạo nhiếp ảnh thực hành tại Đà Nẵng.</p></div><div><strong>98 Điện Biên Phủ, Đà Nẵng</strong><p>Hotline: 0888 445 997</p></div></div><div class="p2-wrap" style="margin-top:36px;border-top:1px solid rgba(255,255,255,.18);padding-top:20px">© 2026 Hang Đôi Academy</div></footer>'
def write(slug,html):
 p=OUT/slug/'index.html'; p.parent.mkdir(parents=True,exist_ok=True); p.write_text(html,encoding='utf-8')
faq='<div class="p2-faq"><details><summary>Người chưa biết dùng máy ảnh có học được không?</summary><p>Có. Lộ trình cơ bản bắt đầu từ cách vận hành máy, phơi sáng, lấy nét và cân bằng trắng.</p></details><details><summary>Có cần mua máy ảnh ngay không?</summary><p>Không bắt buộc. Academy có môi trường studio và thiết bị phục vụ thực hành.</p></details><details><summary>Có hỗ trợ portfolio không?</summary><p>Có. Các lộ trình dài và chuyên sâu đều có project hoặc sản phẩm đầu ra.</p></details></div>'
