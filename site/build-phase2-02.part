for slug,name,tag,price,duration,lead,who,out,modules in courses:
 url=f'{ROOT}/{slug}/'; title=f'Khóa {name} tại Đà Nẵng | Hang Đôi Academy'; desc=f'{lead} Học thực hành tại studio Hang Đôi Academy, Đà Nẵng.'
 schema={'@context':'https://schema.org','@type':'Course','name':name,'description':lead,'url':url,'provider':{'@type':'EducationalOrganization','name':'Hang Đôi Academy','url':ROOT}}
 cards=''.join(f'<article class="p2-card"><b>0{i}</b><h3>{m}</h3><p>Học qua hướng dẫn, bài tập thực hành và feedback trực tiếp.</p></article>' for i,m in enumerate(modules,1))
 html=head(title,desc,url,schema)+f'''<body class="p2-page">{nav()}<main><section class="p2-hero"><div class="p2-wrap"><div class="p2-breadcrumb"><a href="/">Trang chủ</a> / <a href="/khoa-hoc/">Khóa học</a> / {name}</div><span class="p2-eyebrow">{tag}</span><h1>{name}</h1><p class="p2-lead">{lead}</p><div class="p2-actions"><a class="p2-cta" href="/#tu-van">Đăng ký tư vấn</a><a class="p2-cta p2-ghost" href="#noi-dung">Xem nội dung học</a></div><div class="p2-facts"><div class="p2-fact"><small>Học phí</small><strong>{price}</strong></div><div class="p2-fact"><small>Thời lượng</small><strong>{duration}</strong></div><div class="p2-fact"><small>Phù hợp</small><strong>{who}</strong></div><div class="p2-fact"><small>Đầu ra</small><strong>{out}</strong></div></div></div></section><section class="p2-section alt" id="noi-dung"><div class="p2-wrap"><div class="p2-section-head"><h2>Nội dung học theo bốn chặng.</h2><p>Khung chương trình được cá nhân hóa theo điểm xuất phát nhưng vẫn giữ đầu ra rõ ràng.</p></div><div class="p2-grid">{cards}</div></div></section><section class="p2-section"><div class="p2-wrap"><div class="p2-section-head"><h2>Cách học tại Academy.</h2><p>Đánh giá đầu vào, thực hành, feedback và hoàn thiện sản phẩm.</p></div><div class="p2-grid"><article class="p2-card yellow"><b>01</b><h3>Đánh giá xuất phát điểm</h3><p>Xác định mục tiêu, thiết bị và năng lực hiện tại.</p></article><article class="p2-card"><b>02</b><h3>Thực hành trực tiếp</h3><p>Học trong studio và bối cảnh thật.</p></article><article class="p2-card dark"><b>03</b><h3>Feedback trên sản phẩm</h3><p>Sửa kỹ thuật, tư duy và quy trình làm việc.</p></article></div></div></section><section class="p2-section alt"><div class="p2-wrap"><div class="p2-section-head"><h2>Câu hỏi thường gặp.</h2><p>Thông tin cần biết trước khi bắt đầu.</p></div>{faq}</div></section></main>{footer()}</body></html>'''
 write(slug,html)

cards=''.join(f'<article class="p2-card"><b>{tag}</b><h3>{name}</h3><p>{lead}</p><p><strong>{price}</strong></p><a class="p2-cta" href="/{slug}/">Xem chi tiết</a></article>' for slug,name,tag,price,duration,lead,who,out,modules in courses)
write('khoa-hoc',head('Các khóa học nhiếp ảnh tại Đà Nẵng | Hang Đôi Academy','So sánh các lộ trình nhiếp ảnh cơ bản, kỹ thuật, ánh sáng, chỉnh sửa và toàn tập tại Hang Đôi Academy.',ROOT+'/khoa-hoc/')+f'<body class="p2-page">{nav()}<main><section class="p2-hero"><div class="p2-wrap"><span class="p2-eyebrow">Lộ trình đào tạo</span><h1>Chọn khóa học theo đầu ra.</h1><p class="p2-lead">Không mặc định khóa học phí cao nhất. Mỗi lộ trình phù hợp với một xuất phát điểm và mục tiêu khác nhau.</p></div></section><section class="p2-section alt"><div class="p2-wrap"><div class="p2-grid">{cards}</div></div></section></main>{footer()}</body></html>')

write('giang-vien',head('Giảng viên và môi trường đào tạo | Hang Đôi Academy','Tìm hiểu phương pháp đào tạo, kinh nghiệm dự án và môi trường production house tại Hang Đôi Academy.',ROOT+'/giang-vien/')+f'''<body class="p2-page">{nav()}<main><section class="p2-hero"><div class="p2-wrap"><span class="p2-eyebrow">Người hướng dẫn</span><h1>Học từ người đang trực tiếp làm nghề.</h1><p class="p2-lead">Nội dung đào tạo được phát triển từ quy trình sản xuất hình ảnh thương mại của Hang Đôi Production.</p><div class="p2-facts"><div class="p2-fact"><small>Chuyên môn</small><strong>Nhiếp ảnh thương mại</strong></div><div class="p2-fact"><small>Lĩnh vực</small><strong>Hospitality · F&amp;B · Product</strong></div><div class="p2-fact"><small>Phương pháp</small><strong>Thực hành và feedback</strong></div><div class="p2-fact"><small>Môi trường</small><strong>Studio đang vận hành</strong></div></div></div></section><section class="p2-section alt"><div class="p2-wrap"><div class="p2-grid"><article class="p2-card"><b>01</b><h3>Tư duy hình ảnh</h3><p>Đọc mục tiêu, xây moodboard và chọn giải pháp phù hợp.</p></article><article class="p2-card yellow"><b>02</b><h3>Quy trình sản xuất</h3><p>Từ chuẩn bị thiết bị đến tổ chức buổi chụp và chọn ảnh.</p></article><article class="p2-card dark"><b>03</b><h3>Tiêu chuẩn đầu ra</h3><p>Đánh giá sản phẩm theo yêu cầu sử dụng thật.</p></article></div></div></section></main>{footer()}</body></html>''')
