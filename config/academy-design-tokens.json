{
  "meta": {
    "name": "Hang Đôi Academy Design Tokens",
    "version": "2.0.0",
    "concept": "Creative Learning Studio × Editorial Poster × Production Culture",
    "source": "Reference-led system derived from approved Academy visual references and current Academy brand assets",
    "status": "canonical-design-source-draft",
    "prefix": "aca"
  },
  "color": {
    "allocation": {
      "paperNeutral": "60%",
      "green": "20%",
      "orangeCobaltCombined": "10%",
      "yellowAccent": "10%",
      "rule": "Yellow is a signal color only. Do not use yellow as a dominant full-section background except for intentionally small, high-attention blocks."
    },
    "primitive": {
      "ink": {
        "800": "#24483A",
        "900": "#17382B",
        "950": "#101713"
      },
      "paper": {
        "0": "#FFFDF7",
        "50": "#F8F4EA",
        "100": "#F2ECDF",
        "200": "#E8DFD0"
      },
      "green": {
        "100": "#E8F4DF",
        "300": "#A7D67B",
        "500": "#68B96D",
        "700": "#239653",
        "800": "#176B43",
        "900": "#145238",
        "950": "#0F422D"
      },
      "yellow": {
        "100": "#FFF7CB",
        "300": "#FFE783",
        "500": "#F2D43D",
        "700": "#C9A700"
      },
      "orange": {
        "100": "#FFE1D3",
        "300": "#FF9A72",
        "500": "#F26A3D",
        "700": "#C94A22"
      },
      "cobalt": {
        "100": "#E8ECFF",
        "300": "#8091ED",
        "500": "#3450D8",
        "700": "#2338A8"
      },
      "functional": {
        "red": "#D95C4F",
        "neutral500": "#6C756F",
        "neutral300": "#AEB6B0",
        "neutral200": "#D5DBD6"
      },
      "logo": {
        "primary": "#00031A",
        "accent": "#FCB415"
      }
    },
    "semantic": {
      "bgCanvas": "{color.primitive.paper.50}",
      "bgPaper": "{color.primitive.paper.0}",
      "bgSoft": "{color.primitive.paper.100}",
      "bgDark": "{color.primitive.green.950}",
      "bgBrand": "{color.primitive.green.800}",
      "textDisplay": "{color.primitive.ink.950}",
      "textHeading": "{color.primitive.ink.900}",
      "textBody": "{color.primitive.ink.800}",
      "textMuted": "{color.primitive.functional.neutral500}",
      "textInverse": "{color.primitive.paper.0}",
      "brand": "{color.primitive.green.800}",
      "brandActive": "{color.primitive.green.700}",
      "brandSoft": "{color.primitive.green.100}",
      "signalYellow": "{color.primitive.yellow.500}",
      "signalOrange": "{color.primitive.orange.500}",
      "signalCobalt": "{color.primitive.cobalt.500}",
      "focus": "{color.primitive.cobalt.500}",
      "danger": "{color.primitive.functional.red}"
    },
    "usageRules": {
      "yellow": [
        "CTA accent",
        "sticker",
        "eyebrow marker",
        "step number",
        "single keyword highlight",
        "small geometric shape"
      ],
      "yellowAvoid": [
        "full-page background",
        "multiple adjacent large cards",
        "long body text background",
        "more than roughly 10% of a viewport composition"
      ],
      "green": [
        "brand anchor",
        "dark inverse section",
        "primary CTA",
        "navigation emphasis",
        "large brand shapes"
      ],
      "orange": [
        "energy / event / human / production signal",
        "one medium block or shape per composition"
      ],
      "cobalt": [
        "learning system / editorial contrast",
        "secondary signal",
        "diagram / metadata emphasis"
      ]
    }
  },
  "typography": {
    "family": {
      "display": "Inter, Helvetica Neue, Arial, sans-serif",
      "body": "Inter, Helvetica Neue, Arial, sans-serif",
      "mono": "SFMono-Regular, Consolas, Liberation Mono, monospace"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800,
      "black": 900
    },
    "roles": {
      "posterXL": {
        "size": "clamp(72px, 10vw, 152px)",
        "lineHeight": 0.82,
        "letterSpacing": "-0.075em",
        "weight": 900
      },
      "posterLG": {
        "size": "clamp(60px, 8vw, 120px)",
        "lineHeight": 0.84,
        "letterSpacing": "-0.07em",
        "weight": 900
      },
      "display": {
        "size": "clamp(48px, 6vw, 88px)",
        "lineHeight": 0.9,
        "letterSpacing": "-0.06em",
        "weight": 900
      },
      "heading1": {
        "size": "clamp(36px, 4.5vw, 68px)",
        "lineHeight": 1,
        "letterSpacing": "-0.05em",
        "weight": 900
      },
      "heading2": {
        "size": "clamp(28px, 3vw, 44px)",
        "lineHeight": 1.02,
        "letterSpacing": "-0.04em",
        "weight": 800
      },
      "heading3": {
        "size": "clamp(22px, 2vw, 28px)",
        "lineHeight": 1.05,
        "letterSpacing": "-0.03em",
        "weight": 800
      },
      "bodyXL": {
        "size": "20px",
        "lineHeight": 1.5,
        "weight": 400
      },
      "bodyLG": {
        "size": "18px",
        "lineHeight": 1.55,
        "weight": 400
      },
      "body": {
        "size": "15px",
        "lineHeight": 1.55,
        "weight": 400
      },
      "bodySM": {
        "size": "14px",
        "lineHeight": 1.55,
        "weight": 400
      },
      "label": {
        "size": "12px",
        "lineHeight": 1.2,
        "letterSpacing": "0.11em",
        "weight": 800,
        "textTransform": "uppercase"
      },
      "micro": {
        "size": "11px",
        "lineHeight": 1.3,
        "letterSpacing": "0.08em",
        "weight": 700
      }
    },
    "rules": {
      "display": "Oversized, compact, high contrast, often broken into 2–4 short lines.",
      "body": "Neutral and readable. Never use negative tracking.",
      "labels": "Uppercase only for metadata, tags, step numbers, categories and status.",
      "maxLineLength": "Body copy should normally stay within 560–760px."
    }
  },
  "spacing": {
    "base": 4,
    "scale": [
      0,
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      56,
      64,
      80,
      96,
      112,
      128,
      160
    ],
    "section": {
      "tight": "clamp(52px, 6vw, 80px)",
      "normal": "clamp(72px, 8vw, 112px)",
      "loose": "clamp(92px, 11vw, 160px)"
    }
  },
  "layout": {
    "max": 1280,
    "wide": 1440,
    "readable": 760,
    "copy": 560,
    "columns": {
      "desktop": 12,
      "tablet": 6,
      "mobile": 4
    },
    "gutters": {
      "desktop": 40,
      "tablet": 28,
      "mobile": 16
    },
    "gaps": {
      "xs": 8,
      "sm": 12,
      "md": 20,
      "lg": 32,
      "xl": 48
    },
    "breakpoints": {
      "xs": 560,
      "sm": 760,
      "md": 900,
      "lg": 1024,
      "xl": 1280
    },
    "principles": [
      "Use asymmetry intentionally.",
      "Allow one dominant block per viewport.",
      "Use offset alignment and controlled overlap.",
      "Do not repeat equal card grids section after section.",
      "Mobile is recomposed, not merely scaled down."
    ]
  },
  "composition": {
    "archetypes": {
      "posterHero": {
        "structure": "Oversized headline + image crop + 1–3 geometric shapes + compact metadata",
        "dominantArea": "55–70%",
        "yellowLimit": "<=10%"
      },
      "editorialSplit": {
        "structure": "7/5 or 8/4 asymmetric split",
        "use": "story, explanation, proof"
      },
      "posterGrid": {
        "structure": "mixed spans across 12-column grid",
        "use": "course outcomes, learner work, events"
      },
      "galleryStrip": {
        "structure": "edge-to-edge image rhythm with captions",
        "use": "production/learning proof"
      },
      "timeline": {
        "structure": "large step numbers + offset content columns",
        "use": "curriculum, process, journey"
      },
      "manifesto": {
        "structure": "large type on dark/green surface with sparse supporting copy",
        "use": "positioning / philosophy"
      },
      "signalBlock": {
        "structure": "single orange/cobalt/yellow block within neutral composition",
        "use": "attention reset",
        "yellowRule": "yellow should be the smallest of signal blocks"
      }
    }
  },
  "shape": {
    "types": [
      "circle",
      "archTop",
      "archBottom",
      "capsule",
      "bar",
      "sticker",
      "cropBlock"
    ],
    "radii": {
      "none": 0,
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "full": 999
    },
    "circleSizes": {
      "sm": 64,
      "md": 128,
      "lg": 240,
      "xl": 420
    },
    "rotation": {
      "subtleNegative": -2,
      "subtlePositive": 2,
      "strongNegative": -4,
      "strongPositive": 4
    },
    "rules": [
      "Shapes should create hierarchy, crop, or directional movement.",
      "Do not decorate every section.",
      "One dominant geometric gesture is preferable to many small icons."
    ]
  },
  "image": {
    "principles": [
      "Prefer real Academy learning, Hang Đôi Production, equipment, learner output and commercial work.",
      "Crop decisively instead of fitting the full image.",
      "Treat photography as a graphic block.",
      "Pair image with short caption/metadata when useful.",
      "Avoid stock imagery when real material exists."
    ],
    "radii": {
      "editorial": 0,
      "soft": 12,
      "feature": 24
    },
    "aspectRatios": {
      "portrait": "4/5",
      "landscape": "3/2",
      "wide": "16/9",
      "square": "1/1"
    },
    "filters": {
      "saturation": 1.04,
      "contrast": 1.02
    },
    "overlays": {
      "dark": "linear-gradient(180deg, rgba(16,23,19,0) 38%, rgba(16,23,19,.78) 100%)",
      "green": "linear-gradient(135deg, rgba(15,66,45,.14), rgba(15,66,45,0))",
      "warm": "linear-gradient(135deg, rgba(242,106,61,.16), rgba(242,212,61,.06))"
    }
  },
  "border": {
    "hairline": 1,
    "strong": 2,
    "poster": 3,
    "color": "{color.primitive.ink.950}"
  },
  "shadow": {
    "printSM": "4px 4px 0 #101713",
    "printMD": "7px 7px 0 #101713",
    "printAccent": "7px 7px 0 #F2D43D",
    "softSM": "0 10px 30px rgba(16,23,19,.06)",
    "softMD": "0 20px 56px rgba(16,23,19,.10)",
    "media": "0 30px 80px rgba(16,23,19,.18)"
  },
  "motion": {
    "duration": {
      "fast": 140,
      "base": 220,
      "slow": 360,
      "media": 520
    },
    "easing": {
      "standard": "cubic-bezier(.2,.8,.2,1)",
      "enter": "cubic-bezier(.16,1,.3,1)",
      "exit": "cubic-bezier(.4,0,1,1)"
    },
    "hover": {
      "lift": -3,
      "mediaScale": 1.025
    },
    "rules": [
      "Use motion to reveal reading order or interaction state.",
      "No continuous floating decorations.",
      "No bouncing CTA.",
      "Respect prefers-reduced-motion."
    ]
  },
  "components": {
    "header": {
      "heightDesktop": 76,
      "heightMobile": 64,
      "blur": 16
    },
    "button": {
      "heightSm": 42,
      "heightMd": 50,
      "heightLg": 56,
      "paddingX": 22,
      "radius": 999,
      "fontSize": 14,
      "fontWeight": 800
    },
    "posterButton": {
      "radius": 8,
      "border": 2,
      "shadow": "4px 4px 0 #101713"
    },
    "field": {
      "height": 52,
      "radius": 8,
      "paddingX": 16
    },
    "tag": {
      "height": 32,
      "paddingX": 10,
      "radius": 999,
      "fontSize": 12
    },
    "card": {
      "radius": 12,
      "softRadius": 16,
      "padding": 24,
      "defaultShadow": "none"
    },
    "posterCard": {
      "radius": 8,
      "border": 2,
      "shadow": "4px 4px 0 #101713"
    },
    "accessibility": {
      "hitTargetMin": 44,
      "focusWidth": 3
    }
  }
}
